# =============================================================================
# Staging stand secrets — COPY to .env.staging (gitignored) and fill in.
#   cp docker/staging/.env.staging.example docker/staging/.env.staging
# NEVER commit .env.staging. The pre-push hook + gitleaks guard against it.
#
# ONE app instance manages EVERY account below in-process (telegram.accounts).
# Add an account: append a TELEGRAM_ACCOUNTS_<n>_* block (n = 0,1,2,…) and
# extend BOT_PERSONA_IDS, then restart. 2 accounts or 100 — no compose change.
# =============================================================================

STAGING_DB_NAME=news_aggregator_db
STAGING_DB_USER=staging
STAGING_DB_PASSWORD=change-me-staging
STAGING_APP_PORT=8099

# SACRED: TDLight sessions + tdlib state live here. Use a STABLE host dir OUTSIDE
# the repo — a bind mount survives `docker compose down -v`, `docker volume prune`,
# `docker system prune` and every git op. Once authorized, NEVER delete it; back it up.
STAGING_DATA_DIR=/absolute/path/OUTSIDE/the/repo/chat-orchestrator-staging

# Primary account = the FIRST id here. Admin command chat id.
BOT_PERSONA_IDS=1000000001,1000000002
TELEGRAM_ALLOWEDCOMMANDCHATID=123456789
TELEGRAM_SHAREDFILESDIRECTORY=/data/shared

# --- Account 0 (PRIMARY) --- api_id/api_hash from https://my.telegram.org
TELEGRAM_ACCOUNTS_0_BOTID=1000000001
TELEGRAM_ACCOUNTS_0_APIID=
TELEGRAM_ACCOUNTS_0_APIHASH=
TELEGRAM_ACCOUNTS_0_PHONENUMBER=
TELEGRAM_ACCOUNTS_0_SESSIONSDIRECTORY=/data/sessions/1000000001

# --- Account 1 ---
TELEGRAM_ACCOUNTS_1_BOTID=1000000002
TELEGRAM_ACCOUNTS_1_APIID=
TELEGRAM_ACCOUNTS_1_APIHASH=
TELEGRAM_ACCOUNTS_1_PHONENUMBER=
TELEGRAM_ACCOUNTS_1_SESSIONSDIRECTORY=/data/sessions/1000000002

# --- LLM backends (the bot generates replies via DeepSeek) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

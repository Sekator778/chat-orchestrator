# =============================================================================
# atlas stand (Apple Silicon) — environment for the NATIVE app run.
#   cp docker/atlas/.env.atlas.example docker/atlas/.env.atlas
# `orchstack.sh app start` sources .env.atlas (gitignored) into the JVM.
#
# Everything below is either a local-infra coordinate or a dummy: real values
# arrive from winbox WSL (docker/staging/.env.staging + the TDLight session
# directories). Until they do, the stand boots headless on the smoke profile.
# =============================================================================

# --- Local infrastructure (docker/atlas/docker-compose.yml) ------------------
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=news_aggregator_db
DATABASE_USERNAME=staging
DATABASE_PASSWORD=staging

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
MEMO_QDRANT_URL=http://127.0.0.1:6335

# Native TEI service already running on this machine (BAAI/bge-m3, 1024-dim) —
# the same model the staging `embeddings` container serves, so no container here.
EMBEDDING_URL=http://127.0.0.1:8087

# --- App -------------------------------------------------------------------
SERVER_PORT=8099
# Actuator + Swagger surface. /actuator/health is how this stand is checked.
APP_HTTP_ENABLED=true

# Headless boot with dummy credentials, exactly like the smoke stand: the smoke
# profile turns the TDLight client off (telegram.client.enabled=false), pins a
# placeholder DeepSeek endpoint and disables every client-reaching scheduler, so
# the app comes up green with no Telegram account at all.
# Once the real accounts and secrets are restored from winbox, switch this to
# `staging` — that profile turns the real TDLight client on and reads the
# TELEGRAM_ACCOUNTS_* block below.
SPRING_PROFILES_ACTIVE=smoke
LOG_LEVEL_APP=INFO

# --- Telegram accounts (DUMMY — real values arrive from winbox WSL) ---------
# One app instance manages every account listed here in-process. Add an account:
# append a TELEGRAM_ACCOUNTS_<n>_* block (n = 0,1,2,…) and extend BOT_PERSONA_IDS.
# SESSIONSDIRECTORY is a HOST path on this stand (no container, no bind mount) —
# point it at the tree pulled from winbox: <STAGING_DATA_DIR>/sessions/<botId>.
# Never delete it: re-authorizing needs the phone code again.
BOT_PERSONA_IDS=1000000001,1000000002
TELEGRAM_ALLOWEDCOMMANDCHATID=123456789
TELEGRAM_SHAREDFILESDIRECTORY=./tdlib-sessions/shared

TELEGRAM_ACCOUNTS_0_BOTID=1000000001
TELEGRAM_ACCOUNTS_0_APIID=
TELEGRAM_ACCOUNTS_0_APIHASH=
TELEGRAM_ACCOUNTS_0_PHONENUMBER=
TELEGRAM_ACCOUNTS_0_SESSIONSDIRECTORY=./tdlib-sessions/1000000001

TELEGRAM_ACCOUNTS_1_BOTID=1000000002
TELEGRAM_ACCOUNTS_1_APIID=
TELEGRAM_ACCOUNTS_1_APIHASH=
TELEGRAM_ACCOUNTS_1_PHONENUMBER=
TELEGRAM_ACCOUNTS_1_SESSIONSDIRECTORY=./tdlib-sessions/1000000002

# --- LLM backend (DUMMY — real key arrives from winbox WSL) -----------------
DEEPSEEK_API_KEY=atlas-placeholder

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example LaunchAgent: poll CI hourly and deliver the newest green main build to
  this stand. This is the macOS counterpart of the WSL stand's
  ops/systemd/staging-deliver.timer - same job, same cadence, different init.

  Optional: scripts/atlas-deliver.sh is idempotent and safe to run by hand, and
  running it by hand is the better default until the stand has proven itself.

  Install with docker/atlas/bin/install-deliver-agent.sh: it fills the two
  placeholders in, applies the interval and branch options, and loads the agent.
  This file is the template it works from; by hand it is the same three steps:

    sed -e "s|__REPO_DIR__|$PWD|g" -e "s|__HOME__|$HOME|g" \
      docker/atlas/com.example.orch-deliver.plist.example \
      > ~/Library/LaunchAgents/com.example.orch-deliver.plist
    plutil -lint ~/Library/LaunchAgents/com.example.orch-deliver.plist
    mkdir -p ~/.orch-deploy
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.orch-deliver.plist

  Run once on demand / inspect / remove:
    launchctl kickstart -p gui/$(id -u)/com.example.orch-deliver
    launchctl print gui/$(id -u)/com.example.orch-deliver
    launchctl bootout gui/$(id -u)/com.example.orch-deliver

  It is a LaunchAgent, not a LaunchDaemon, on purpose: it needs the logged-in
  user's Docker socket, gh credentials and JDK, none of which a root daemon has.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.orch-deliver</string>

    <!-- A login shell picks up the user's PATH (Homebrew gh, sdkman JDK, docker
         from OrbStack); EnvironmentVariables below is the fallback for the case
         where the shell profile does not run under launchd. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec __REPO_DIR__/scripts/atlas-deliver.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- The branch the stand follows. main carries the promoted releases;
             the installer rewrites this value. -->
        <key>ORCH_BRANCH</key>
        <string>main</string>
    </dict>

    <!-- Hourly; the installer rewrites this value. A poll that finds nothing new
         exits in about a second (one `gh run list` call and a string compare), so
         a shorter interval is cheap if you want the stand to follow dev closely.
         -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Deliberately false: a deploy on login would restart the app while the
         stand is still coming up. The first poll follows one interval later; use
         `launchctl kickstart` when you want one right away. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.orch-deploy/deliver.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.orch-deploy/deliver.log</string>
</dict>
</plist>

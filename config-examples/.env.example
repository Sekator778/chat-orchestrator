# Telegram API Configuration
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=+1234567890

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=news_aggregator_db
DATABASE_USERNAME=bot_user
DATABASE_PASSWORD=your_secure_password_here

# LLM API Configuration (DeepSeek)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT=30000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=telegram-user-bot
KAFKA_TOPIC_INCOMING_MESSAGES=telegram

# HTTP Server Configuration (optional)
HTTP_ENABLED=true
SERVER_PORT=8080

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_TELEGRAMUSERBOT=DEBUG
LOGGING_FILE_PATH=logs/application.log

# News System Configuration
NEWS_CLUSTERING_ENABLED=true
NEWS_SCORING_ENABLED=true
NEWS_SYNTHESIS_ENABLED=true

# Test Bot Tokens (for personas)
TEST_BOT_TOKEN_1=<TELEGRAM_BOT_TOKEN>x
TEST_BOT_TOKEN_2=<TELEGRAM_BOT_TOKEN>y
